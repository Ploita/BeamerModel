%~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Footer

% Keep page number anchored regardless of frame content height.
\setbeamertemplate{footline}{
\begin{beamercolorbox}[wd=\paperwidth,ht=2.6ex,dp=1.2ex,leftskip=10mm,rightskip=10mm]{}
\hfill\color{primary}\footnotesize\insertframenumber{}
\end{beamercolorbox}
\vspace*{0.35cm}
}

\mode<all>

