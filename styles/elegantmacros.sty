% Define folder tree
\def\beamer@calltheme#1#2#3{%
    \def\beamer@themelist{#2}
    \@for\beamer@themename:=\beamer@themelist\do
    {\usepackage[{#1}]{\beamer@themelocation/#3\beamer@themename}}}

\def\usefolder#1{
    \def\beamer@themelocation{#1}
  }
%~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

% Reusable figure block: image if file exists, otherwise a placeholder box.
% Args: 1=file path, 2=caption.
\newcommand{\FigureWithFallbackCaption}[2]{%
  \begingroup
  \begin{minipage}{\linewidth}
    \centering
    \IfFileExists{#1}{%
      \includegraphics[width=\linewidth]{#1}%
    }{%
      \fbox{\parbox[c][0.48\textheight][c]{\linewidth}{\centering
      Diretório quebrado}}%
    }%
    \captionsetup{type=figure,width=\linewidth,justification=justified,singlelinecheck=false}
    \caption{#2}%
  \end{minipage}
  \endgroup
}

% Convenience block command with automatic pause after the block.
% Usage: \BlockPause{Title}{content}
\newcommand{\BlockPause}[2]{%
  \begin{block}{#1}
    #2
  \end{block}
  \pause
}

% Convenience equation command with line break and pause after equation.
% Usage: \EquationPause{a=b}
\newcommand{\EquationPause}[1]{%
  \begin{equation*}
    #1
  \end{equation*}
  \newline
  \pause
}

% Lowercase aliases.
\newcommand{\blockpause}[2]{\BlockPause{#1}{#2}}
\newcommand{\equationpause}[1]{\EquationPause{#1}}
  
\mode<all>
